+    public static async Task<ImageHolder> ResizeImageSave(Stream imgStream, CancellationToken cancellationToken, int resizeMaxWidth = ResizeMaxWidthDefault)
+    {
+        if (resizeMaxWidth < 1 || resizeMaxWidth > Limits.MaxImageDimension)
+            throw Error.LocalStr("Invalid image size");
+        try
+        {
+            using var limitedInput = new LimitStream(imgStream, Limits.MaxImageStreamSize);
+            using var input = new MemoryStream();
+            await limitedInput.CopyToAsync(input, cancellationToken);
+            input.Position = 0;
+            var output = new MemoryStream();
+            try
+            {
+                var boundedOutput = new LimitStream(output, Limits.MaxImageStreamSize);
+                var result = await Cli.Wrap("ffmpeg")
+                    .WithArguments(["-hide_banner", "-loglevel", "error", "-max_pixels", "100000000", "-protocol_whitelist", "pipe", "-i", "pipe:0", "-frames:v", "1", "-vf", $"scale=w='min({resizeMaxWidth},iw)':h=-2", "-f", "image2pipe", "-vcodec", "mjpeg", "pipe:1"])
+                    .WithStandardInputPipe(PipeSource.FromStream(input))
+                    .WithStandardOutputPipe(PipeTarget.ToStream(boundedOutput))
+                    .WithStandardErrorPipe(PipeTarget.Null)
+                    .WithValidation(CommandResultValidation.None)
+                    .ExecuteAsync(cancellationToken);
+                if (result.ExitCode != 0 || output.Length == 0)
+                    throw Error.LocalStr("Dropping image because of unknown format");
+                output.Position = 0;
+                return new ImageHolder(output, "image/jpeg");
+            }
+            catch { output.Dispose(); throw; }
+        }
+        catch (EntityTooLargeException)
+        {
+            Log.Debug("Dropping image because too large");
+            throw Error.LocalStr("Dropping image because too large");
+        }
+    }
